+}
+.col .ctl-wide {
+  grid-template-columns: minmax(0, 1fr);
+}
+input,
+select,
+textarea,
+button {
+  font-family: inherit;
+}
+input[type="text"],
+input[type="number"],
+select,
+textarea {
+  min-height: 40px;
+  padding: 6px 10px;
+  background: var(--void);
+  border: 1px solid var(--edge-control);
+  border-radius: var(--r);
+  color: var(--ink);
+  font-size: 14px;
+}
+input[type="number"] {
+  width: 5rem;
+}
+input[type="range"] {
+  width: 100%;
+  min-height: 32px;
+  padding: 0;
+  accent-color: var(--g);
+  background: none;
+  border: 0;
+}
+input[type="checkbox"],
+input[type="radio"] {
+  width: 18px;
+  height: 18px;
+  padding: 0;
+  accent-color: var(--g);
+}
+input[type="color"] {
+  width: 44px;
+  height: 40px;
+  padding: 2px;
+}
+button {
+  border-radius: var(--r);
+  transition:
+    border-color 150ms,
+    color 150ms,
+    background 150ms,
+    transform 100ms var(--ease);
+}
+button:active:not(:disabled) {
+  transform: scale(0.97);
+}
+button.mini,
+.mini {
+  min-height: 36px;
+  padding: 0 12px;
+  background: var(--graphite);
+  border: 1px solid var(--edge-control);
+  color: var(--ink);
+  font: 600 13px / 1 var(--font-ui);
+  text-decoration: none;
+}
+a.mini {
+  display: inline-flex;
+  align-items: center;
+}
+button.mini:hover:not(:disabled),
+a.mini:hover {
+  border-color: var(--g);
+  color: var(--g);
+}
+button.mini.danger {
+  color: var(--bad);
+}
+button.mini.danger:hover:not(:disabled) {
+  color: var(--ink);
+}
+.pick-btn {
+  width: 100%;
+  min-height: 48px;
+  margin: 12px 0 4px;
+  background: rgba(57, 255, 136, 0.05);
+  border: 1px dashed var(--g);
+  color: var(--g);
+  font: 600 15px var(--font-ui);
+}
+.pick-btn:hover {
+  background: rgba(57, 255, 136, 0.12);
+}
+.ctl:has(#file) {
+  display: none;
+}
+#text-text {
+  min-height: 72px;
+}
+.note,
+.dim,
+.field-unit {
