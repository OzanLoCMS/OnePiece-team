@@ -0,0 +1,1109 @@
+/* OnePiece Team Map Art: workspace shell.
+   Loaded after style.css. Layout, chrome and control language only; component internals
+   (palette, loadout, text editor) keep their own rules in style.css. */
+
+:root {
+  --hdr: 56px;
+  --tabs: 44px;
+  --dock: 56px;
+  --chrome: calc(var(--hdr) + var(--tabs));
+  --pad: 16px;
+  --tap: 44px;
+}
+
+html {
+  scroll-padding-top: calc(var(--chrome) + 8px);
+  background: var(--bg);
+}
+body {
+  margin: 0;
+  background: var(--bg);
+  color: var(--ink);
+  font: 400 var(--t-body) / 1.5 var(--font-ui);
+  overflow-x: hidden;
+}
+a {
+  color: var(--b);
+}
+:where(a, button, input, select, textarea, summary, [tabindex]):focus-visible {
+  outline: 2px solid var(--focus);
+  outline-offset: 2px;
+}
+
+/* ------------------------------------------------------------------ app bar */
+.appbar {
+  position: sticky;
+  top: 0;
+  z-index: 40;
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  height: var(--hdr);
+  padding: 0 var(--pad);
+  background: rgba(7, 9, 10, 0.96);
+  border-bottom: 1px solid var(--rule);
+}
+.back {
+  flex: none;
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: var(--tap);
+  padding: 0 14px 0 10px;
+  border: 1px solid var(--rule);
+  color: var(--ink);
+  text-decoration: none;
+  font: 600 14px / 1 var(--font-ui);
+  white-space: nowrap;
+  transition:
+    border-color 150ms,
+    color 150ms,
+    transform 100ms var(--ease);
+}
+.back:hover {
+  border-color: var(--g);
+  color: var(--g);
+}
+.back:active {
+  transform: scale(0.97);
+}
+.appbar-title {
+  display: flex;
+  align-items: center;
+  gap: 12px;
+  min-width: 0;
+}
+.appbar-logo {
+  display: block;
+  height: 28px;
+  width: auto;
+  mix-blend-mode: lighten;
+}
+.appbar h1 {
+  display: flex;
+  align-items: baseline;
+  gap: 8px;
+  margin: 0;
+  min-width: 0;
+  white-space: nowrap;
+}
+.appbar-app {
+  font: 900 28px / 1 var(--font-display);
+  text-transform: uppercase;
+  letter-spacing: 0.015em;
+}
+.appbar-sep {
+  color: var(--rule);
+  font: 400 14px var(--font-mono);
+}
+.appbar-by {
+  font: 400 13px var(--font-mono);
+  color: var(--dim);
+}
+.beta-chip {
+  margin: 0 0 0 4px;
+  padding: 1px 6px;
+  border: 1px solid var(--edge-control);
+  border-radius: var(--r);
+  font: 400 11px / 1.4 var(--font-mono);
+  letter-spacing: 0.04em;
+  color: var(--warn);
+}
+.appbar-spacer {
+  flex: 1 1 0;
+}
+.ver {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+}
+.ver-label {
+  font: 400 11px var(--font-mono);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--dim);
+}
+.ver select {
+  min-height: 40px;
+  min-width: 5.5rem;
+}
+.status {
+  margin: 0;
+  max-width: 24ch;
+  overflow: hidden;
+  text-overflow: ellipsis;
+  white-space: nowrap;
+  font: 400 12px var(--font-mono);
+  color: var(--dim);
+}
+.help {
+  position: relative;
+}
+.help-btn {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  min-height: var(--tap);
+  min-width: var(--tap);
+  justify-content: center;
+  padding: 0 12px;
+  background: none;
+  border: 1px solid var(--rule);
+  border-radius: 0;
+  color: var(--ink);
+  font: 600 14px var(--font-ui);
+}
+.help-btn:hover,
+.help-btn[aria-expanded="true"] {
+  border-color: var(--g);
+  color: var(--g);
+}
+.help-menu {
+  position: absolute;
+  right: 0;
+  top: calc(100% + 6px);
+  z-index: 70;
+  min-width: 16rem;
+  background: var(--graphite);
+  border: 1px solid var(--edge-control);
+  box-shadow: 0 16px 40px rgba(0, 0, 0, 0.55);
+}
+.help-menu[hidden] {
+  display: none;
+}
+.help-menu a {
+  display: flex;
+  align-items: center;
+  min-height: var(--tap);
+  padding: 0 16px;
+  color: var(--ink);
+  text-decoration: none;
+  font: 400 14px var(--font-ui);
+  border-top: 1px solid var(--edge-soft);
+}
+.help-menu a:first-child {
+  border-top: 0;
+}
+.help-menu a:hover,
+.help-menu a:focus-visible {
+  background: rgba(57, 255, 136, 0.08);
+  color: var(--g);
+}
+
+/* ------------------------------------------------------------------ workspace tabs */
+.tabbar {
+  position: sticky;
+  top: var(--hdr);
+  z-index: 39;
+  display: flex;
+  height: var(--tabs);
+  padding: 0 var(--pad);
+  background: var(--bg);
+  border-bottom: 1px solid var(--rule);
+}
+.tab {
+  display: inline-flex;
+  align-items: center;
+  gap: 8px;
+  height: 100%;
+  padding: 0 18px;
+  margin: 0 0 -1px;
+  background: none;
+  border: 0;
+  border-bottom: 2px solid transparent;
+  border-radius: 0;
+  color: var(--dim);
+  font: 600 14px var(--font-ui);
+  transition:
+    color 150ms,
+    border-color 150ms;
+}
+.tab:hover {
+  color: var(--ink);
+}
+.tab[aria-selected="true"] {
+  color: var(--ink);
+  border-bottom-color: var(--g);
+}
+.tab .ico {
+  flex: none;
+}
+.tab-en {
+  display: none;
+}
+
+.help-opt:empty {
+  display: none;
+}
+.help-opt {
+  border-top: 1px solid var(--edge-soft);
+}
+#explain-bar {
+  display: flex;
+  align-items: center;
+  min-height: var(--tap);
+  padding: 0 16px;
+  font-size: 14px;
+  color: var(--ink);
+}
+#explain-bar label {
+  gap: 10px;
+  min-height: var(--tap);
+  cursor: pointer;
+}
+
+/* ------------------------------------------------------------------ workspace */
+main#workspace {
+  display: block;
+  max-width: none;
+  padding: 0;
+}
+.view[hidden] {
+  display: none;
+}
+section {
+  min-width: 0;
+}
+
+/* section titles */
+h2 {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: baseline;
+  gap: 4px 10px;
+  margin: 0 calc(-1 * var(--pad)) 8px;
+  padding: 16px var(--pad) 12px;
+  background: none;
+  border: 0;
+  border-bottom: 1px solid var(--rule);
+  border-radius: 0;
+  font: 900 26px / 1 var(--font-display);
+  text-transform: uppercase;
+  letter-spacing: 0.02em;
+}
+h2 > .dim {
+  font: 400 12px var(--font-mono);
+  letter-spacing: 0.04em;
+  text-transform: none;
+  color: var(--dim);
+}
+
+/* ------------------------------------------------------------------ studio: three panels */
+.studio {
+  display: grid;
+  grid-template-columns: minmax(300px, 340px) minmax(0, 1fr) minmax(300px, 340px);
+  height: calc(100vh - var(--chrome));
+  /* biome-ignore lint/suspicious/noDuplicateProperties: 100vh fallback for browsers without dvh */
+  height: calc(100dvh - var(--chrome));
+  min-height: 560px;
+}
+.col {
+  min-width: 0;
+  min-height: 0;
+  background: var(--panel);
+}
+.col-left,
+.col-right {
+  overflow-y: auto;
+  overscroll-behavior: contain;
+  scrollbar-width: thin;
+  scrollbar-color: var(--edge-control) transparent;
+}
+.col-left {
+  border-right: 1px solid var(--rule);
+}
+.col-right {
+  border-left: 1px solid var(--rule);
+}
+.col-center {
+  display: flex;
+  flex-direction: column;
+  background: var(--bg);
+}
+.col section {
+  background: none;
+  border: 0;
+  border-radius: 0;
+  padding: 0 var(--pad) 28px;
+  overflow: visible;
+}
+.col-left h2,
+.col-right h2 {
+  position: sticky;
+  top: 0;
+  z-index: 3;
+  background: var(--panel);
+}
+
+/* preview stage */
+#preview-panel {
+  position: static;
+  align-self: stretch;
+  width: 100%;
+  display: flex;
+  flex-direction: column;
+  flex: 1 1 auto;
+  min-height: 0;
+  padding: 0;
+  max-width: none;
+  background: var(--bg);
+}
+.pv-bar {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px 16px;
+  padding: 8px var(--pad);
+  background: var(--panel);
+  border-bottom: 1px solid var(--rule);
+}
+.pv-bar h2 {
+  flex: 1 1 auto;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  font-size: 22px;
+  position: static;
+  background: none;
+}
+.pv-tools {
+  display: flex;
+  align-items: center;
+  gap: 6px;
+  margin: 0;
+}
+.pv-tools .icon {
+  min-width: 40px;
+  font-size: 18px;
+  line-height: 1;
+}
+.chip-toggle {
+  min-height: 36px;
+  padding: 0 12px;
+  border: 1px solid var(--edge-control);
+  background: var(--graphite);
+  font: 600 13px var(--font-ui);
+  color: var(--ink);
+  cursor: pointer;
+}
+.chip-toggle:has(input:checked) {
+  border-color: var(--g);
+  color: var(--g);
+}
+#preview-place {
+  display: none;
+}
+.progress {
+  flex: none;
+  height: 3px;
+  margin: 0;
+  background: var(--edge-soft);
+}
+#preview-slot {
+  position: relative;
+  flex: 1 1 auto;
+  min-height: 0;
+  display: flex;
+  padding: 16px;
+  overflow: auto;
+  overscroll-behavior: contain;
+  background:
+    linear-gradient(rgba(57, 255, 136, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
+    linear-gradient(90deg, rgba(57, 255, 136, 0.035) 1px, transparent 1px) 0 0 / 32px 32px,
+    var(--void);
+}
+#preview-wrap {
+  position: relative;
+  display: block;
+  flex: none;
+  margin: auto;
+}
+#preview {
+  border: 1px solid var(--edge-control);
+}
+#preview-empty {
+  background: rgba(13, 17, 19, 0.7);
+  border-width: 1px;
+  border-color: var(--edge-control);
+  font: 600 14px var(--font-ui);
+}
+.preview-empty-mark {
+  font: 300 44px / 1 var(--font-ui);
+}
+#preview-away {
+  margin: 16px;
+}
+#preview-hint {
+  display: none;
+}
+.panel-utility {
+  margin: 0;
+  padding: 10px var(--pad);
+  background: var(--panel);
+  border-top: 1px solid var(--rule);
+}
+.panel-utility .utility-row {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 8px;
+  margin: 0;
+}
+.panel-utility .utility-row .danger {
+  margin-left: auto;
+}
+#preview-panel.hidden-preview {
+  flex: 0 0 auto;
+}
+#preview-panel.hidden-preview #preview-slot,
+#preview-panel.hidden-preview .progress {
+  display: none;
+}
+
+/* ------------------------------------------------------------------ accordion sections */
+.subsection {
+  margin: 0;
+  padding: 0;
+  border-bottom: 1px solid var(--rule);
+}
+.subsection:last-child {
+  border-bottom: 0;
+}
+.sub-head {
+  display: flex;
+  flex-wrap: wrap;
+  align-items: center;
+  gap: 4px 8px;
+  min-height: 48px;
+  margin: 0;
+  padding: 0;
+  border: 0;
+  font: 600 12px / 1.3 var(--font-mono);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--ink);
+}
+.sub-head label {
+  min-height: var(--tap);
+  font: inherit;
+  cursor: pointer;
+}
+.sub-head .mini {
+  letter-spacing: 0;
+  text-transform: none;
+}
+.sub-head .fold {
+  order: 99;
+  margin-left: auto;
+  width: var(--tap);
+  height: var(--tap);
+  margin-right: -10px;
+  background: none;
+  border: 0;
+  border-radius: 0;
+  color: var(--dim);
+  font-size: 14px;
+  transition:
+    transform 150ms var(--ease),
+    color 150ms;
+}
+.sub-head .fold:hover {
+  color: var(--g);
+}
+.subsection.collapsed .fold {
+  transform: rotate(-90deg);
+}
+.subsection:not(.collapsed) > .sub-head {
+  color: var(--g);
+}
+.subsection > :not(.sub-head) {
+  margin-bottom: 4px;
+}
+.subsection:not(.collapsed) {
+  padding-bottom: 14px;
+}
+.group-label {
+  margin: 12px 0 2px;
+  font: 400 11px var(--font-mono);
+  letter-spacing: 0.1em;
+  text-transform: uppercase;
+  color: var(--dim);
+}
+
+/* ------------------------------------------------------------------ controls in panels */
+.col .ctl,
+.col .ctl-range {
+  grid-template-columns: minmax(0, 1fr);
+  row-gap: 4px;
+  padding: 8px 0;
+  border-top: 0;
+}
+.col .ctl > .field-name {
+  font: 600 11px var(--font-mono);
+  letter-spacing: 0.08em;
+  text-transform: uppercase;
+  color: var(--dim);
+}
+.col .ctl-range {
