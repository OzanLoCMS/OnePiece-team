+  }
+  .tab {
+    flex: 1 1 0;
+    flex-direction: column;
+    justify-content: center;
+    gap: 3px;
+    padding: 0 4px;
+    margin: 0;
+    border-bottom: 0;
+    border-top: 2px solid transparent;
+    font-size: 12px;
