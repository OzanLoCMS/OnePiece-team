diff --git a/web/src/shell.ts b/web/src/shell.ts
new file mode 100644
index 0000000..b435a1f
--- /dev/null
+++ b/web/src/shell.ts
@@ -0,0 +1,282 @@
+// OnePiece Team workspace shell: tabs, mobile sheets and the help menu.
+// This module only moves visibility and focus around. It never touches the engine, the data
+// flow or any value in main.ts; every control keeps its original element id.
+
+type View = "studio" | "palette" | "tools" | "export";
+type Pane = "left" | "right";
+
+const VIEWS: View[] = ["studio", "palette", "tools", "export"];
+const SHEET_MQ = matchMedia("(max-width: 1099.98px)");
+
+const $ = (id: string) => document.getElementById(id);
+
+let pane: Pane | null = null;
+let paneOpener: HTMLElement | null = null;
+
+function isView(v: string | undefined): v is View {
+  return VIEWS.includes(v as View);
+}
+
+function setView(view: View, focusTab = false): void {
+  if (pane) closePane(false);
+  closeHelp(false);
+  document.body.dataset.view = view;
+  for (const tab of document.querySelectorAll<HTMLButtonElement>("#tabbar .tab")) {
+    const on = tab.dataset.view === view;
+    tab.setAttribute("aria-selected", String(on));
+    tab.tabIndex = on ? 0 : -1;
+    if (on && focusTab) tab.focus();
+  }
+  for (const el of document.querySelectorAll<HTMLElement>("#workspace > .view")) {
+    el.hidden = el.dataset.view !== view;
+  }
+}
+
+function wireTabs(): void {
+  const tabs = [...document.querySelectorAll<HTMLButtonElement>("#tabbar .tab")];
+  for (const tab of tabs) {
+    tab.onclick = () => {
+      const v = tab.dataset.view;
+      if (isView(v)) {
+        setView(v);
+        window.scrollTo({ top: 0 });
+      }
+    };
+    tab.onkeydown = (ev) => {
+      const i = tabs.indexOf(tab);
+      let next = -1;
+      if (ev.key === "ArrowRight") next = (i + 1) % tabs.length;
+      else if (ev.key === "ArrowLeft") next = (i - 1 + tabs.length) % tabs.length;
+      else if (ev.key === "Home") next = 0;
+      else if (ev.key === "End") next = tabs.length - 1;
+      if (next < 0) return;
+      ev.preventDefault();
+      const v = tabs[next].dataset.view;
+      if (isView(v)) setView(v, true);
+    };
+  }
+  setView("studio");
+}
+
+// In-page links (#export-panel and friends) must first reveal the tab that holds the target.
+function wireHashLinks(): void {
+  document.addEventListener("click", (ev) => {
+    const a = (ev.target as Element).closest?.<HTMLAnchorElement>('a[href^="#"]');
+    if (!a || a.getAttribute("href") === "#") return;
+    const target = document.getElementById(a.getAttribute("href")?.slice(1) ?? "");
+    if (!target) return;
+    const holder = target.closest<HTMLElement>(".view");
+    ev.preventDefault();
+    if (holder && isView(holder.dataset.view)) setView(holder.dataset.view);
+    target.scrollIntoView({ block: "start" });
+    if (target.tabIndex >= 0) target.focus({ preventScroll: true });
+  });
+}
+
+// A whole section header toggles its fold, not just the small chevron. Real controls inside the
+// header (checkboxes, buttons, links) keep their own behaviour.
+function wireFoldHeaders(): void {
+  document.addEventListener("click", (ev) => {
+    const target = ev.target as Element;
+    const head = target.closest<HTMLElement>(".sub-head");
+    if (!head || target.closest("button, input, select, textarea, label, a")) return;
+    head.querySelector<HTMLButtonElement>(":scope > .fold")?.click();
+  });
+}
+
+// ---------------------------------------------------------------- sheets (phones and tablets)
+function paneEl(p: Pane): HTMLElement | null {
+  return $(p === "left" ? "col-left" : "col-right");
+}
+
+function syncDock(): void {
+  for (const btn of document.querySelectorAll<HTMLButtonElement>("#studio-dock .dock-btn")) {
+    btn.setAttribute("aria-pressed", String(btn.dataset.pane === pane));
+  }
+}
+
+function openPane(p: Pane, opener: HTMLElement | null): void {
+  if (!SHEET_MQ.matches) return;
+  if (pane && pane !== p) closePane(false);
+  pane = p;
+  paneOpener = opener;
+  document.body.dataset.pane = p;
+  document.body.classList.add("sheet-open");
+  const el = paneEl(p);
+  if (el) {
+    el.setAttribute("role", "dialog");
+    el.setAttribute("aria-modal", "true");
+    el.setAttribute("aria-label", p === "left" ? "Görsel ve kompozisyon" : "Üretim ayarları");
+    el.tabIndex = -1;
+    el.scrollTop = 0;
+    el.focus({ preventScroll: true });
+  }
+  const back = $("sheet-backdrop");
+  if (back) back.hidden = false;
+  syncDock();
+}
+
+function closePane(restoreFocus = true): void {
+  if (!pane) return;
+  const el = paneEl(pane);
+  el?.removeAttribute("role");
+  el?.removeAttribute("aria-modal");
+  el?.removeAttribute("aria-label");
+  pane = null;
+  delete document.body.dataset.pane;
+  document.body.classList.remove("sheet-open");
+  const back = $("sheet-backdrop");
+  if (back) back.hidden = true;
+  syncDock();
+  if (restoreFocus) paneOpener?.focus();
+  paneOpener = null;
+}
+
+function trapFocus(ev: KeyboardEvent): void {
+  if (!pane || ev.key !== "Tab") return;
+  const el = paneEl(pane);
+  if (!el) return;
+  const items = [
+    ...el.querySelectorAll<HTMLElement>(
+      'a[href], button:not([disabled]), input:not([disabled]):not([type="hidden"]), select:not([disabled]), textarea:not([disabled]), [tabindex]:not([tabindex="-1"])',
+    ),
+  ].filter((n) => n.offsetParent !== null);
+  if (!items.length) return;
+  const first = items[0];
+  const last = items[items.length - 1];
+  const active = document.activeElement;
+  if (ev.shiftKey && (active === first || active === el)) {
+    ev.preventDefault();
+    last.focus();
+  } else if (!ev.shiftKey && active === last) {
+    ev.preventDefault();
+    first.focus();
+  }
+}
+
+function wireSheets(): void {
+  const titles: Record<Pane, string> = { left: "Görsel ve kompozisyon", right: "Üretim ayarları" };
+  for (const p of ["left", "right"] as Pane[]) {
+    const el = paneEl(p);
+    if (!el) continue;
+    const bar = document.createElement("div");
+    bar.className = "sheet-bar";
+    const grip = document.createElement("span");
+    grip.className = "sheet-title";
+    grip.textContent = titles[p];
+    const close = document.createElement("button");
+    close.type = "button";
+    close.className = "sheet-close";
+    close.setAttribute("aria-label", "Kapat");
+    close.textContent = "Bitti";
+    close.onclick = () => closePane();
+    bar.append(grip, close);
+    el.prepend(bar);
+  }
+  for (const btn of document.querySelectorAll<HTMLButtonElement>("#studio-dock .dock-btn")) {
+    btn.onclick = () => {
+      const p = btn.dataset.pane as Pane;
+      if (pane === p) closePane();
+      else openPane(p, btn);
+    };
+  }
+  $("sheet-backdrop")?.addEventListener("click", () => closePane());
+  document.addEventListener("keydown", (ev) => {
+    if (ev.key === "Escape" && pane) {
+      ev.preventDefault();
+      closePane();
+    }
+    trapFocus(ev);
+  });
+  SHEET_MQ.addEventListener("change", () => {
+    if (!SHEET_MQ.matches) closePane(false);
+  });
+  // A new picture is the end of that task: put the preview back in front.
+  $("file")?.addEventListener("change", () => closePane(false));
+  $("img-pick")?.addEventListener("click", () => $("file")?.click());
+}
+
+// ---------------------------------------------------------------- help menu
+function closeHelp(restoreFocus = true): void {
+  const menu = $("help-menu");
+  const btn = $("help-btn");
+  if (!menu || menu.hidden) return;
+  menu.hidden = true;
+  btn?.setAttribute("aria-expanded", "false");
+  if (restoreFocus) btn?.focus();
+}
+
+function wireHelp(): void {
+  const menu = $("help-menu");
+  const btn = $("help-btn");
+  if (!menu || !btn) return;
+  btn.onclick = () => {
+    const open = menu.hidden;
+    menu.hidden = !open;
+    btn.setAttribute("aria-expanded", String(open));
+    if (open) menu.querySelector<HTMLElement>("a")?.focus();
+  };
+  document.addEventListener("click", (ev) => {
+    if (!menu.hidden && !(ev.target as Element).closest(".help")) closeHelp(false);
+  });
+  menu.addEventListener("keydown", (ev) => {
+    const links = [...menu.querySelectorAll<HTMLElement>("a")];
+    const i = links.indexOf(document.activeElement as HTMLElement);
+    if (ev.key === "Escape") {
+      ev.preventDefault();
+      closeHelp();
+    } else if (ev.key === "ArrowDown") {
+      ev.preventDefault();
+      links[(i + 1) % links.length]?.focus();
+    } else if (ev.key === "ArrowUp") {
+      ev.preventDefault();
+      links[(i - 1 + links.length) % links.length]?.focus();
+    }
+  });
+}
+
+// ---------------------------------------------------------------- palette search
+// Display-only: hides rendered rows that do not match. Palette state and the solver never see it.
+function wirePaletteSearch(): void {
+  const input = $("palette-search") as HTMLInputElement | null;
+  const root = $("palette");
+  const count = $("palette-search-count");
+  if (!input || !root) return;
+  let frame = 0;
+  const apply = () => {
+    frame = 0;
+    const q = input.value.trim().toLowerCase();
+    const rows = root.querySelectorAll<HTMLElement>(".palette-row, tbody tr");
+    let shown = 0;
+    for (const row of rows) {
+      let hit = !q;
+      if (!hit) {
+        let hay = row.textContent ?? "";
+        for (const el of row.querySelectorAll<HTMLElement>("[title], [aria-label]")) {
+          hay += ` ${el.title} ${el.getAttribute("aria-label") ?? ""}`;
+        }
+        hit = hay.toLowerCase().includes(q);
+      }
+      row.classList.toggle("pal-hide", !hit);
+      if (hit) shown++;
+    }
+    if (count) count.textContent = q ? `${shown} of ${rows.length} colors match` : "";
+  };
+  const schedule = () => {
+    if (!frame) frame = requestAnimationFrame(apply);
+  };
+  input.addEventListener("input", schedule);
+  new MutationObserver(() => {
+    if (input.value) schedule();
+  }).observe(root, { childList: true });
+}
+
+export function initShell(): void {
+  wireTabs();
+  wireHashLinks();
+  wireFoldHeaders();
+  wireSheets();
+  wireHelp();
+  wirePaletteSearch();
+  document.body.dataset.shell = "ready";
+}
